{
  "manifest_version": 3,
  "name": "Trend Investorr Screener Connector",
  "version": "1.1.2",
  "minimum_chrome_version": "114",
  "description": "Reads visible Screener.in query results in your signed-in Chrome session for Trend Investorr.",
  "permissions": ["storage", "alarms"],
  "host_permissions": [
    "https://www.screener.in/*",
    "https://screener.in/*",
    "http://localhost:3000/*",
    "http://127.0.0.1:3000/*"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "content_scripts": [
    {
      "matches": ["http://localhost:3000/*", "http://127.0.0.1:3000/*"],
      "js": ["app-bridge.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://www.screener.in/*", "https://screener.in/*"],
      "js": ["screener-core.js", "screener-content.js"],
      "run_at": "document_idle"
    }
  ]
}
