# ============================================
# Angel One SmartAPI Credentials
# Get from: https://smartapi.angelbroking.com/
# ============================================
ANGEL_API_KEY=your_api_key_here
ANGEL_CLIENT_ID=your_client_id_here
ANGEL_PASSWORD=your_password_here
ANGEL_TOTP_SECRET=your_totp_secret_here

# ============================================
# Upstox Fundamentals API (read-only Analytics Token)
# Generate from Upstox Developer Apps > Analytics.
# The token is valid for one year and is stored in the encrypted vault.
# ============================================
UPSTOX_ANALYTICS_TOKEN=
UPSTOX_API_BASE_URL=https://api.upstox.com/v2
UPSTOX_INSTRUMENTS_URL=https://assets.upstox.com/market-quote/instruments/exchange/NSE.json.gz
UPSTOX_HTTP_TIMEOUT_SECONDS=20
UPSTOX_MAX_RETRIES=3
UPSTOX_MAX_REQUESTS_PER_RUN=2000
UPSTOX_REQUESTS_PER_MINUTE=500
UPSTOX_REQUESTS_PER_30_MINUTES=2000
UPSTOX_MAX_BATCHES_PER_CYCLE=24
UPSTOX_BATCH_INTERVAL_MINUTES=30
UPSTOX_MAX_STOCKS_PER_RUN=0
UPSTOX_SYNC_HOUR=16
UPSTOX_SYNC_MINUTE=20
UPSTOX_WEEKLY_SYNC_HOUR=0
UPSTOX_WEEKLY_SYNC_MINUTE=0
UPSTOX_PROFILE_REFRESH_DAYS=30
UPSTOX_STATEMENT_REFRESH_DAYS=7
UPSTOX_RATIO_REFRESH_DAYS=1
UPSTOX_SHAREHOLDING_REFRESH_DAYS=7
UPSTOX_CORPORATE_ACTION_REFRESH_DAYS=1
UPSTOX_COMPETITOR_REFRESH_DAYS=30

# ============================================
# Google Gemini AI (optional, for GeminiAnalyzer)
# Get from: https://aistudio.google.com/apikey
# ============================================
GEMINI_API_KEY=your_gemini_api_key_here

# ============================================
# PostgreSQL Database
# ============================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=trend_investorr
DB_USER=postgres
DB_PASSWORD=your_db_password_here
DB_MIN_CONNECTIONS=2
DB_MAX_CONNECTIONS=10

# ============================================
# Application Settings
# ============================================
APP_ENV=development
LOG_LEVEL=INFO
VAULT_MASTER_KEY=
