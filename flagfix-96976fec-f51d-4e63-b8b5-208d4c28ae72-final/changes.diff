+def buy(om):
+    return om.execute_signal(
+        make_signal(signal_type=SignalType.BUY, price=PRICE),
+        make_analysis_result(action=AnalysisAction.BUY),
+    )
+
+
+def sent(broker):
+    return [(p["transactiontype"], p["quantity"]) for p in broker.placed]
