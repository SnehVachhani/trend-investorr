+                                 stranger("BSEX", exchange="BSE", status="open"))  # a BSE look-alike alongside
+
+    second = buy(om)
+
+    assert second is not None and second.success and second.broker_order_id == "BRK2", second.message
+    assert sent(broker) == [("BUY", "176"), ("BUY", "176")]
