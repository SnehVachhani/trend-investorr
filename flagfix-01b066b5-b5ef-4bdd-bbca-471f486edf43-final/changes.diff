+def make_runner(om, notifier, *, now, wait):
+    from trading.square_off_followup import SquareOffFollowUp
+    return SquareOffFollowUp(
+        om, notifier, delay_s=60, interval_s=60, max_attempts=3, now=now, wait=wait,
+    )
